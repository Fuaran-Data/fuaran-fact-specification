{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "staleness-policy.schema.json",
  "title": "Staleness policy (§7.1): how a fact carrying the metric goes stale",
  "oneOf": [
    {
      "type": "object",
      "required": ["kind", "windowSeconds"],
      "properties": {
        "kind": { "const": "freshFor" },
        "windowSeconds": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
      }
    },
    { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "untilSuperseded" } } },
    { "type": "object", "required": ["kind"], "properties": { "kind": { "const": "untilUpstreamChange" } } }
  ]
}
