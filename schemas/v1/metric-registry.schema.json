{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metric-registry.schema.json",
  "title": "Metric registry (§7.4): metric definitions in ascending ordinal id order, ids unique",
  "type": "object",
  "required": ["kind", "wireVersion", "metrics"],
  "properties": {
    "kind": { "const": "metricRegistry" },
    "wireVersion": { "$ref": "common.schema.json#/$defs/wireVersion" },
    "metrics": { "type": "array", "items": { "$ref": "metric-definition.schema.json" } }
  }
}
