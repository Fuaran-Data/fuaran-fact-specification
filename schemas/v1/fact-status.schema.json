{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fact-status.schema.json",
  "title": "Fact status (§6.5, §6.6): a fact's derived forecastness and freshness at an instant",
  "type": "object",
  "required": ["kind", "wireVersion", "fact", "staleness", "current", "at", "forecast", "fresh"],
  "properties": {
    "kind": { "const": "factStatus" },
    "wireVersion": { "$ref": "common.schema.json#/$defs/wireVersion" },
    "fact": { "$ref": "fact.schema.json" },
    "staleness": { "$ref": "staleness-policy.schema.json" },
    "current": { "type": "boolean" },
    "at": { "$ref": "common.schema.json#/$defs/instant" },
    "forecast": { "type": "boolean" },
    "fresh": { "type": "boolean" }
  }
}
