{
  "specification": "fact-wire",
  "wireVersion": 1,
  "scope": "whole-corpus",
  "families": [
    "identity",
    "lineage",
    "record",
    "definition",
    "registry",
    "rendering",
    "history",
    "view",
    "status"
  ],
  "reservedFamilies": [],
  "laws": {
    "L1": [
      "history"
    ],
    "L2": [
      "identity",
      "record",
      "history"
    ],
    "L3": [
      "lineage",
      "history"
    ],
    "L4": [
      "view"
    ]
  },
  "digests": {
    "identity": "the fact id (§4): lower-case hex SHA-256 over the identity frame, recomputed from the document's own members",
    "lineage": "the lineage digest (§6.1): lower-case hex SHA-256 over the UTF-8 bytes of the lineage key, recomputed from the document's own members; the vector's lineageKey is the key itself",
    "definition": "the definition digest (§7.5): sha256: + lower-case hex SHA-256 over the document's bytes",
    "registry": "the definition digest (§7.5): sha256: + lower-case hex SHA-256 over the document's bytes"
  },
  "schemas": {
    "fact": "../schemas/v1/fact.schema.json",
    "metricDefinition": "../schemas/v1/metric-definition.schema.json",
    "subjectDefinition": "../schemas/v1/subject-definition.schema.json",
    "metricRegistry": "../schemas/v1/metric-registry.schema.json",
    "subjectRegistry": "../schemas/v1/subject-registry.schema.json",
    "factHistory": "../schemas/v1/fact-history.schema.json",
    "asOfView": "../schemas/v1/as-of-view.schema.json",
    "factStatus": "../schemas/v1/fact-status.schema.json",
    "renderedValue": "../schemas/v1/rendered-value.schema.json"
  },
  "rejectClasses": [
    "not-canonical",
    "shape-invalid",
    "kind-unknown",
    "version-unsupported",
    "decimal-invalid",
    "instant-invalid",
    "token-invalid",
    "interval-inverted",
    "period-inverted",
    "fact-id-mismatch",
    "unit-invalid",
    "display-format-invalid",
    "registry-unordered",
    "history-id-repeated",
    "supersedes-unknown",
    "supersedes-cross-lineage",
    "supersedes-not-later",
    "supersedes-not-head",
    "supersedes-missing",
    "view-mismatch",
    "status-mismatch",
    "rendering-mismatch"
  ],
  "relations": [
    {
      "ids": "equal",
      "vectors": [
        "identity/computed-scalar",
        "identity/computed-value-differs"
      ],
      "why": "a Computed fact's value is outside the frame"
    },
    {
      "ids": "equal",
      "vectors": [
        "identity/computed-scalar",
        "identity/computed-rerun-converges"
      ],
      "why": "a re-run over the same inputs converges (L2): asOf, resultRef and triggerRef are outside the frame"
    },
    {
      "ids": "equal",
      "vectors": [
        "identity/computed-scalar",
        "identity/computed-inputs-permuted"
      ],
      "why": "input hashes are sorted into the frame"
    },
    {
      "ids": "equal",
      "vectors": [
        "identity/computed-scalar",
        "identity/computed-outside-frame-differs"
      ],
      "why": "label, asOf, confidence and disclosure are outside the frame"
    },
    {
      "ids": "distinct",
      "vectors": [
        "identity/computed-scalar",
        "identity/computed-version-bump"
      ],
      "why": "the method identity is in the frame"
    },
    {
      "ids": "distinct",
      "vectors": [
        "identity/computed-scalar",
        "identity/computed-input-changed"
      ],
      "why": "the input hashes are in the frame"
    },
    {
      "ids": "distinct",
      "vectors": [
        "identity/asserted-scalar",
        "identity/asserted-value-differs"
      ],
      "why": "a HumanAsserted fact folds its value's hash into the frame"
    },
    {
      "ids": "distinct",
      "vectors": [
        "identity/asserted-scalar",
        "identity/asserted-scale-differs"
      ],
      "why": "decimal text is the value: 412000.0 and 412000.00 hash differently"
    },
    {
      "ids": "distinct",
      "vectors": [
        "identity/asserted-scalar",
        "identity/asserted-principal-differs"
      ],
      "why": "the principal is the method identity"
    },
    {
      "ids": "equal",
      "vectors": [
        "identity/asserted-series",
        "identity/asserted-series-locator"
      ],
      "why": "a series locator is a hint, never identity"
    },
    {
      "ids": "distinct",
      "vectors": [
        "identity/asserted-series",
        "identity/asserted-series-host-key"
      ],
      "why": "a series address, content address or host key, is the asserted value (§4.4)"
    },
    {
      "history": "extends",
      "vectors": [
        "history/lineage-prefix",
        "history/lineage-and-competitors"
      ],
      "why": "a later snapshot keeps every earlier fact, byte for byte, in order (L1)"
    },
    {
      "history": "doesNotExtend",
      "vectors": [
        "history/lineage-prefix",
        "history/lineage-rewritten"
      ],
      "why": "a fact's value was changed in place: each snapshot is valid alone, and together they break L1"
    }
  ],
